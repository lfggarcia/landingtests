{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spark Template Config",
  "type": "object",
  "required": ["brand", "palette", "fonts", "sections"],
  "properties": {
    "brand": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "tagline": { "type": "string" }
      }
    },
    "palette": {
      "type": "object",
      "required": ["bg", "text", "primary"],
      "properties": {
        "bg": { "type": "string" },
        "text": { "type": "string" },
        "primary": { "type": "string" },
        "secondary": { "type": "string" },
        "muted": { "type": "string" }
      }
    },
    "fonts": {
      "type": "object",
      "properties": {
        "heading": { "type": "string" },
        "body": { "type": "string" }
      }
    },
    "sections": {
      "type": "object",
      "properties": {
        "hero": {
          "type": "object",
          "properties": {
            "visible": { "type": "boolean" },
            "headline": { "type": "string" },
            "subheadline": { "type": "string" },
            "cta": {
              "type": "object",
              "properties": {
                "primary": { "type": "object", "properties": { "label": { "type": "string" }, "href": { "type": "string" } } },
                "secondary": { "type": "object", "properties": { "label": { "type": "string" }, "href": { "type": "string" } } }
              }
            }
          }
        }
      }
    },
    "social": { "type": "object" },
    "fomo": {
      "type": "object",
      "properties": {
        "counterLabel": { "type": "string" },
        "counterValue": { "type": "number" },
        "countdownTarget": { "type": "string" }
      }
    }
  }
}
